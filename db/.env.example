# Local Supabase secrets. Copy this file to `db/.env` (gitignored).
#
# It feeds two things:
#   1. `env(...)` substitution in supabase/config.toml (the Slack OIDC
#      credentials), read by `pnpm db:start`
#   2. the edge function, via `pnpm functions:serve --env-file db/.env`
#
# On hosted Supabase these live in two places instead: the Slack OIDC
# credentials go in the dashboard (Authentication > Providers), and the
# function secrets are set with `supabase secrets set KEY=value`.

# Provided automatically by `supabase start`; copy from its output.
SUPABASE_URL=http://127.0.0.1:54521
SUPABASE_SERVICE_ROLE_KEY=

# TechTank Slack incoming-webhook URL. TBD — leave blank locally and the
# apply-to-task function logs the notification instead of posting it.
SLACK_WEBHOOK_URL=

# Slack bot token (xoxb-...) for DMing applicants and opening the
# assignment group DM. Needs chat:write, im:write and mpim:write. Leave
# blank and the functions log what they would have sent instead.
SLACK_BOT_TOKEN=

# Public site URL used to build task/admin links in the Slack message.
PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Slack (OIDC) credentials, from the Slack app's Basic
# Information page. Read by config.toml when the local stack starts.
#
# NOTE: the CLI only substitutes non-empty values. Leaving one blank
# passes the literal string `env(SLACK_OIDC_CLIENT_ID)` through to the
# auth server, which looks baffling in logs. Fill them in or expect
# Slack sign-in not to work.
SLACK_OIDC_CLIENT_ID=
SLACK_OIDC_SECRET=

# The callback Slack redirects to, which must match the Redirect URL in
# the Slack app EXACTLY. Slack rejects http://localhost, so for local
# Slack work replace this with your ngrok URL:
#   https://<subdomain>.ngrok-free.app/auth/v1/callback
# The default below is the local auth server, fine to leave alone when
# you aren't testing Slack.
SLACK_OIDC_REDIRECT_URI=http://127.0.0.1:54521/auth/v1/callback
