# Local Supabase secrets. Copy this file to `db/.env` (gitignored).
#
# It feeds `env(...)` substitution in supabase/config.toml (the Slack
# OIDC credentials), read by `pnpm db:start`. On hosted Supabase they go
# in the dashboard (Authentication > Providers) instead. The Slack
# notification secrets live in the app's `.env.local`, not here.

# Sign in with Slack (OIDC) credentials, from the Slack app's Basic
# Information page. Read by config.toml when the local stack starts.
#
# NOTE: the CLI only substitutes non-empty values. Leaving one blank
# passes the literal string `env(SLACK_OIDC_CLIENT_ID)` through to the
# auth server, which looks baffling in logs. Fill them in or expect
# Slack sign-in not to work.
SLACK_OIDC_CLIENT_ID=
SLACK_OIDC_SECRET=

# The callback Slack redirects to, which must match the Redirect URL in
# the Slack app EXACTLY. Slack rejects http://localhost, so for local
# Slack work replace this with your ngrok URL:
#   https://<subdomain>.ngrok-free.app/auth/v1/callback
# The default below is the local auth server, fine to leave alone when
# you aren't testing Slack.
SLACK_OIDC_REDIRECT_URI=http://127.0.0.1:54521/auth/v1/callback
