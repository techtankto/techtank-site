{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignore": [
    "app/events/actions.tsx",
    "components/**/*.{ts,tsx}",
    "constants/**/*.ts",
    "hooks/**/*.ts",
    "stores/**/*.ts",
    "utils/**/*.ts",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "@radix-ui/react-slot",
    "class-variance-authority",
    "clsx",
    "next-themes",
    "posthog-js",
    "tailwind-merge",
    "zod",
    "zustand"
  ],
  "ignoreUnresolved": ["^@/", "^\\."]
}
