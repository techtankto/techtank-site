{
  "name": "techtank-to",
  "version": "1.0.0",
  "private": true,
  "description": "TechTank TO - Toronto's tech community website",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "knip": "knip --fix --format --include-entry-exports --allow-remove-files",
    "validate": "pnpm format:check && pnpm lint && pnpm type:check",
    "fix": "pnpm knip && pnpm format && pnpm lint:fix",
    "type:check": "pnpm exec tsc --noEmit",
    "analyze": "next experimental-analyze",
    "format:check": "oxfmt --check .",
    "dev": "next dev --turbopack",
    "lint:fix": "oxlint --fix .",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "vitest run",
    "scrape:instagram": "tsx --env-file=.env.local scripts/instagram/scrape-instagram.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.3.0-preview.10",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.418.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "knip": "^6.29.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tailwindcss": "^1.6.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
