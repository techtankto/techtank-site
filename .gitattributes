# Normalize line endings to LF in the repo; checkouts use LF on all platforms.
# This prevents the "LF will be replaced by CRLF" churn on Windows.
* text=auto eol=lf

# Treat generated/binary files as binary so Git never touches their line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
