# Instagram scraper (pnpm scrape:instagram). Copy to .env.local and fill in.
# Obtained from a Meta app linked to the @techtankto Instagram Business/Creator
# account. See scripts/instagram/README.md for the setup walkthrough.

# Instagram Business/Creator account user id.
INSTAGRAM_USER_ID=

# Long-lived access token (refresh before it expires, ~60 days).
INSTAGRAM_ACCESS_TOKEN=

# Optional. Graph API version (default: v21.0).
INSTAGRAM_GRAPH_VERSION=

# Optional. How many recent posts to request per run (default: 25).
INSTAGRAM_FETCH_LIMIT=

# Luma Calendar ID (get it from the embed code).
LUMA_CALENDAR_ID=

# PostHog analytics (product analytics + CTA/funnel tracking). Get these from
# your PostHog project settings. Analytics only fires in production builds
# (NODE_ENV=production), so leave these unset for local development.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Pick a Task board (Supabase) ─────────────────────────────
# Values come from `pnpm db:start` output (API URL + anon key). The URL/port
# match db/supabase/config.toml (TechTank's dedicated 5452x block, isolated
# from any other local stack).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slack workspace to pre-select on the Sign in with Slack consent
# screen (e.g. T0123ABCD). The workspace is *enforced* server-side via
# app_settings.slack_team_id; this is only a convenience hint.
NEXT_PUBLIC_SLACK_TEAM_ID=

# Server-only Slack notification secrets, read by the apply and assign
# server actions. Leave them blank locally and the message is logged
# instead of sent.
# Incoming webhook for the organizer channel's new-application alert.
SLACK_WEBHOOK_URL=
# Bot token (xoxb-...) for the applicant receipt and assignment group DM.
# Needs chat:write, im:write and mpim:write.
SLACK_BOT_TOKEN=
# Base for the task and admin links in Slack messages.
PUBLIC_SITE_URL=http://localhost:3000
